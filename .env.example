# Copy to ~/.tailorlist-mcp/.env (or set these in your MCP client config).
# Your own Spotify app, from https://developer.spotify.com/dashboard
# No client secret needed: the login uses PKCE.
SPOTIFY_CLIENT_ID=
# Must be listed exactly in your app's Redirect URIs
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
